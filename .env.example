# Copier vers .env.local pour le développement local
# Sur Vercel / Railway : variables d'environnement du projet

# Railway (après railway up) :
#   railway variables set NEXT_PUBLIC_API_URL=https://votre-backend/api
#   railway variables set NEXT_PUBLIC_API_EMAIL=...
#   railway variables set NEXT_PUBLIC_API_PASSWORD=...

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_EMAIL=
NEXT_PUBLIC_API_PASSWORD=

# Activer le service worker en dev (sinon : npm run build && npm start)
# NEXT_PUBLIC_PWA_DEV=1
